{
    "name": "vacuumtube",
    "version": "2.0.2",
    "description": "YouTube for TV, on your PC",
    "main": "src/index.js",
    "scripts": {
        "start": "electron .",
        "test": "node --test",
        "windows:build": "electron-builder --win",
        "windows:build-portable": "electron-builder --win zip --x64",
        "mac:build": "electron-builder --mac",
        "linux:build": "electron-builder --linux",
        "linux:build-unpacked": "electron-builder --linux --dir",
        "linux:build-appimage": "electron-builder --linux appimage"
    },
    "keywords": [],
    "author": "shy (shy@shy.rocks)",
    "license": "MIT",
    "desktopName": "rocks.shy.VacuumTube",
    "build": {
        "appId": "rocks.shy.VacuumTube",
        "productName": "HomeTube",
        "artifactName": "HomeTube-${arch}.${ext}",
        "linux": {
            "icon": "./assets/icon.svg",
            "synopsis": "Watch and explore videos on YouTube",
            "category": "AudioVideo",
            "desktop": {
                "entry": {
                    "Name": "HomeTube",
                    "Type": "Application",
                    "Categories": "AudioVideo;",
                    "Keywords": "YouTube;YT;"
                }
            },
            "syncDesktopName": true,
            "maintainer": "shy@shy.rocks",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "icon": "./assets/icon.ico",
            "artifactName": "HomeTube-${arch}-Portable.zip",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "nsis": {
            "artifactName": "HomeTube-Setup.${ext}",
            "uninstallDisplayName": "HomeTube",
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "perMachine": false
        },
        "mac": {
            "icon": "./assets/icon.icns",
            "category": "public.app-category.video",
            "electronLanguages": [
                "en",
                "de",
                "nl",
                "tr",
                "hr",
                "sv",
                "id",
                "sr"
            ],
            "files": [
                "src/**",
                "locale/*.json",
                "assets/icon.png"
            ],
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.inherit.plist",
            "extendInfo": {
                "NSMicrophoneUsageDescription": "HomeTube uses the microphone only when you use YouTube voice search."
            },
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64",
                        "universal"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64",
                        "universal"
                    ]
                }
            ]
        },
        "toolsets": {
            "appimage": "1.0.3"
        },
        "appImage": {
            "executableArgs": [
                "--no-sandbox"
            ]
        },
        "publish": {
            "provider": "github",
            "owner": "shy1132",
            "repo": "VacuumTube"
        }
    },
    "devDependencies": {
        "electron": "^44.5.1",
        "electron-builder": "^26.17.0"
    },
    "dependencies": {
        "chokidar": "^6.0.0",
        "electron-updater": "^6.8.11",
        "qrcode": "^1.5.4",
        "string-argv": "^0.3.2",
        "ws": "^8.22.1"
    }
}
